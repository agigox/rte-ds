{
  "extends": [
    "config:recommended",
    "schedule:nonOfficeHours"
  ],
  "branchPrefix": "Renovate_",
  "baseBranchPatterns": [
    "main"
  ],
  "prConcurrentLimit": 3,
  "ignorePaths": [
    "**/node_modules/**"
  ],
  "packageRules": [
    {
      "digest": {
        "enabled": false
      },
      "matchPackageNames": [
        "*"
      ]
    },
    {
      "groupName": "react",
      "matchPackageNames": [
        "react",
        "react-dom"
      ]
    }
  ]
}